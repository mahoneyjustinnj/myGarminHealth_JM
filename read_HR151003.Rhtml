<!--begin.rcode
glimpse(d_sleep_general)
d_sleepLevels <- d_sleep_general %>% select(any_of(c("calendarDate", "sleepLevels")))
fx(d_sleepLevels, "d_sleepLevels extracts calendarDate list from d_sleep_general")
safe_parse_json <- function(x) {
  if (is.null(x) || is.na(x) || x == "") return(NULL)
  x <- gsub("None", "null", x)
  x <- gsub("True", "true", x)
  x <- gsub("False", "false", x)
  x <- gsub("'", "\"", x)
  tryCatch(jsonlite::fromJSON(x), error = function(e) NULL)
}

d_sleepLevels1 <- d_sleepLevels %>%
  mutate(sleepLevels = map(sleepLevels, safe_parse_json)) %>%
  unnest_longer(sleepLevels, values_to = "value", indices_to = "key")
fx(d_sleepLevels1, "d_sleepLevels1 unnests sleepLevels list from d_sleepLevels")
#View(d_sleepLevels1)
str(d_sleepLevels1)

data_sleep <- d_sleepLevels1 %>%
  unnest(cols = value) %>%
  as.data.frame()

data_sleep <- data_sleep %>%
  mutate(
    startTimeGMT   = as.POSIXct(startGMT, format = "%Y-%m-%dT%H:%M:%OS", tz = "GMT"),
    endTimeGMT     = as.POSIXct(endGMT,   format = "%Y-%m-%dT%H:%M:%OS", tz = "GMT"),
    startTimeLocal = with_tz(startTimeGMT, tzone = "America/Toronto"),
    endTimeLocal   = with_tz(endTimeGMT,   tzone = "America/Toronto")
  )

fx(data_sleep, "data_sleep unnests columns from d_sleepLevels1 and converts to proper time format")
str(data_sleep)
View(data_sleep)
end.rcode-->



