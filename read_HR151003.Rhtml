d_sleep_DTO1 <- d_sleep_DTO %>%
  mutate(dailySleepDTO = map(dailySleepDTO, ~ {
    .x <- gsub("None", "null", .x)         # Replace Python None with JSON null
    .x <- gsub("True", "true", .x)         # Replace Python True with JSON true
    .x <- gsub("False", "false", .x)       # Replace Python False with JSON false
    .x <- gsub("'", "\"", .x)              # Replace single quotes with double quotes
    jsonlite::fromJSON(.x)                           # Parse JSON
  })) %>%
  unnest_longer(dailySleepDTO, values_to = "value", indices_to = "key")

