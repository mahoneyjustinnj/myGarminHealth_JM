calculate statistics Kruskall-Wallis
### Heart rate variability (HRV) was analyzed across 43 days, from August 20 to September 30. A Kruskal-Wallis test was used to compare HRV distributions between days, assessing whether any day showed a statistically different pattern. The test identified August 27 as significantly different from the others. In the box plot, August 27 is highlighted in red, while all other days are shown in blue, indicating a distinct physiological deviation on that date

<!--begin.rcode
# Group by date and compute summary stats
stats <- daty %>%
  group_by(calendarDate) %>%
  summarise(
    Min = min(hrvValue, na.rm = TRUE),
    Q1 = quantile(hrvValue, 0.25, na.rm = TRUE),
    Median = median(hrvValue, na.rm = TRUE),
    Q3 = quantile(hrvValue, 0.75, na.rm = TRUE),
    Max = max(hrvValue, na.rm = TRUE),
    IQR = IQR(hrvValue, na.rm = TRUE),
    .groups = "drop"
  )

# Kruskal-Wallis test to detect significant difference
kruskal <- kruskal.test(hrvValue ~ calendarDate, data = daty)

# Identify the day with the highest median (as a proxy for anomaly)
anomaly_day <- stats %>%
  filter(Median == max(Median)) %>%
  pull(calendarDate)

# Add color flag
daty <- daty %>%
  mutate(colorFlag = ifelse(calendarDate == anomaly_day, "Anomaly", "Normal"))

# Plot using plotly
plot_ly(
  data = daty,
  x = ~calendarDate,
  y = ~hrvValue,
  type = "box",
  color = ~colorFlag,
  colors = c("Normal" = "#3498DB", "Anomaly" = "#E74C3C"),
  boxpoints = "all",
  jitter = 0.3,
  pointpos = 0
) %>%
  layout(
    title = "HRV Box Plot by Day with Anomaly Highlighted",
    xaxis = list(title = "Date"),
    yaxis = list(title = "HRV (ms)")
  )

print(stats)
cat("\nKruskal-Wallis p-value:", kruskal$p.value, "\n")
cat("Anomalous day identified:", anomaly_day, "\n")

end.rcode-->

statistics - Dunn's test
The Dunn test is a post-hoc analysis used after a Kruskal-Wallis test to pinpoint which specific groups differ. In your case, it compares heart rate variability (HRV) across individual days. If all days are marked pink, it means the Dunn test found statistically significant differences in HRV between nearly every pair of days. This suggests that HRV fluctuated meaningfully from day to day, rather than following a stable or consistent pattern.
<!--begin.rcode
#install.packages("FSA")
library(FSA)
results <- dunnTest(hrvValue ~ calendarDate, data = daty, method = "bh")

#print(results)
library(dplyr)
library(plotly)
library(FSA)
library(RColorBrewer)

# Summary stats
stats <- daty %>%
  group_by(calendarDate) %>%
  summarise(
    Min = min(hrvValue, na.rm = TRUE),
    Q1 = quantile(hrvValue, 0.25, na.rm = TRUE),
    Median = median(hrvValue, na.rm = TRUE),
    Q3 = quantile(hrvValue, 0.75, na.rm = TRUE),
    Max = max(hrvValue, na.rm = TRUE),
    IQR = IQR(hrvValue, na.rm = TRUE),
    .groups = "drop"
  )

# Kruskal-Wallis test
kruskal <- kruskal.test(hrvValue ~ calendarDate, data = daty)

# Dunn's test for pairwise differences
dunn <- dunnTest(hrvValue ~ calendarDate, data = daty, method = "bh")
dunn_results <- dunn$res

# Extract significantly different days
sig_days <- unique(c(dunn_results$Comparison[dunn_results$P.adj < 0.05]))
sig_days <- unique(unlist(strsplit(sig_days, " - ")))  # split pairs into individual days

# Assign color flags
daty <- daty %>%
  mutate(colorFlag = ifelse(calendarDate %in% sig_days, "Significant", "Normal"))

# Use ColorBrewer palette
colors <- c("Normal" = "#1f78b4", "Significant" = "#e31a1c")  # blue and red

plot_ly(
  data = daty,
  x = ~calendarDate,
  y = ~hrvValue,
  type = "box",
  color = ~colorFlag,
  colors = colors,
  boxpoints = "all",
  jitter = 0.25,
  pointpos = 0,
  marker = list(size = 2.5, opacity = 0.6)
) %>%
  layout(
    title = "HRV Box Plot by Day with Statistically Different Days Highlighted",
    xaxis = list(title = "Date"),
    yaxis = list(title = "HRV (ms)")
  )

print(stats)
cat("\nKruskal-Wallis p-value:", kruskal$p.value, "\n")
cat("Statistically different days identified:\n")
print(sig_days)

sig_days <- unique(unlist(strsplit(
  dunn_results$Comparison[dunn_results$P.adj < 0.05], " - "
))

table(unlist(strsplit(
  dunn_results$Comparison[dunn_results$P.adj < 0.05], " - "
)))
end.rcode-->



